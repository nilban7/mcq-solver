# Optional AI API Keys for live vision solving
# Note: You can also enter these directly in the Desktop UI Settings (⚙️).
# Keys in the browser UI are stored in local browser memory.
# If configured here, they serve as default environment fallbacks.

# Primary Groq API Key (qwen/qwen3.8-27b - 1,000 RPM Free)
GROQ_API_KEY_1=gsk_...

# Secondary Groq API Key (Optional auto-failover if Key 1 hits rate-limit/quota)
GROQ_API_KEY_2=gsk_...

# Google Gemini API Key (Emergency backup #3 if Groq fails)
GEMINI_API_KEY=AIzaSy...

# OpenAI API Key (Optional)
OPENAI_API_KEY=sk-...

PORT=3001
